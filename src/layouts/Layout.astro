---
import { negocio } from '../data/negocio';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Leire Salgado · Maquilladora Profesional en Madrid | Bodas, Caracterización y Body Paint",
  description = "Maquilladora profesional en Madrid especializada en maquillaje de novias y bodas, caracterización de personajes, body paint y editorial. Consulta presupuesto y disponibilidad."
} = Astro.props;

const siteUrl = 'https://www.leiresalgado.com';
const ogImageUrl = new URL('/hero.jpg', siteUrl).href;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SB0NBHK5GD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SB0NBHK5GD');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="maquilladora profesional madrid, maquillaje novias madrid, caracterizacion personajes, body paint madrid, maquillaje editorial, maquillaje eventos madrid, leire salgado" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- SEO Local & Open Graph -->
    <meta name="geo.region" content="ES-M" />
    <meta name="geo.placename" content="Madrid, España" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Leire Salgado · Makeup Artist" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="1920" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Schema.org JSON-LD Estructurado -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfessionalService",
          "@id": `${negocio.web}/#business`,
          "name": `${negocio.nombre} · Makeup Artist & Caracterización`,
          "image": ogImageUrl,
          "url": negocio.web,
          "telephone": "+34670372923",
          "email": negocio.email,
          "priceRange": "$$",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Madrid",
            "addressRegion": "Comunidad de Madrid",
            "addressCountry": "ES"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 40.416775,
            "longitude": -3.703790
          },
          "areaServed": ["Madrid", "Móstoles", "Alcorcón", "Fuenlabrada", "Comunidad de Madrid"],
          "sameAs": [
            negocio.instagram
          ],
          "knowsAbout": [
            "Maquillaje de Novias y Bodas",
            "Caracterización de Personajes",
            "Body Paint Corporal",
            "Maquillaje para Shootings y Editorial",
            "Cursos de Automaquillaje"
          ],
          "description": description
        },
        {
          "@type": "Person",
          "@id": `${negocio.web}/#person`,
          "name": negocio.nombre,
          "jobTitle": negocio.profesion,
          "worksFor": {
            "@id": `${negocio.web}/#business`
          },
          "sameAs": [
            negocio.instagram
          ]
        }
      ]
    })} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Paleta de colores */
    --color-crema: #F2EFE8;
    --color-grafito: #2D2D2D;
    --color-pintalabios: #A62639;   /* Granate cálido / amarronado */
    --color-granate: #A62639;
    --color-granate-hover: #8B1E2E;
    --color-negro: #0D0D0D;
    --color-charcoal: #1A1A1A;

    /* Aliases */
    --color-accent: var(--color-pintalabios);
    --color-accent-ice: var(--color-pintalabios);
    --color-terracota: var(--color-pintalabios);

    /* Tipografías */
    --font-serif: 'Cormorant Garamond', Georgia, serif;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    font-size: 16px;
    background-color: var(--color-negro);
    color: var(--color-crema);
    overflow-x: hidden;
  }

  body {
    font-family: var(--font-sans);
    background-color: var(--color-negro);
    color: var(--color-crema);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overflow-x: hidden;
  }

  ::selection {
    background-color: var(--color-granate);
    color: var(--color-crema);
  }

  /* Utility font classes */
  .font-serif {
    font-family: var(--font-serif);
  }

  .font-sans {
    font-family: var(--font-sans);
  }

  /* Headings & Serif */
  h1, h2, h3, h4 {
    font-family: var(--font-serif);
    font-weight: 400;
    line-height: 1.15;
  }

  h1 em, h2 em, h3 em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  /* Background Utility Classes */
  .bg-negro {
    background-color: var(--color-negro);
    color: var(--color-crema);
  }

  .bg-crema {
    background-color: var(--color-crema);
    color: var(--color-grafito);
  }

  .bg-crema-oscuro {
    background-color: #E8E4DA;
    color: var(--color-grafito);
  }

  .bg-charcoal {
    background-color: var(--color-charcoal);
    color: var(--color-crema);
  }

  .text-granate, .text-terracota, .text-accent {
    color: var(--color-granate);
  }

  .text-crema {
    color: var(--color-crema);
  }

  .text-grafito {
    color: var(--color-grafito);
  }

  .text-muted {
    color: rgba(242, 239, 232, 0.7);
  }

  /* Botones principales estilo Patricia Mayo con Rojo Granate */
  .btn-naranja, .btn-granate, .btn-accent {
    display: inline-block;
    padding: 1em 2.2em;
    background-color: var(--color-granate);
    color: var(--color-crema);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    border: 1px solid var(--color-granate);
    transition: all 0.3s ease;
    cursor: pointer;
    text-align: center;
  }

  .btn-naranja:hover, .btn-granate:hover, .btn-accent:hover {
    background-color: transparent;
    color: var(--color-granate);
  }

  .btn-outline {
    display: inline-block;
    padding: 1em 2.2em;
    background-color: transparent;
    color: var(--color-granate);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    border: 1px solid var(--color-granate);
    transition: all 0.3s ease;
    cursor: pointer;
    text-align: center;
  }

  .btn-outline:hover {
    background-color: var(--color-granate);
    color: var(--color-crema);
  }
</style>
